{
  "name": "antiyoy-barracks",
  "private": true,
  "version": "1.0.0",
  "description": "Antiyoy-style hex strategy with recruitment barracks",
  "author": "IbnKamil",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop": "npm run build && electron .",
    "desktop:dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && ELECTRON_DEV=1 electron .\"",
    "desktop:dist": "npm run build && electron-builder --publish never",
    "desktop:dist:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "desktop:dist:win": "npm run build && electron-builder --win zip --publish never",
    "desktop:dist:mac": "npm run build && electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "@fontsource/outfit": "^5.2.8",
    "@fontsource/source-serif-4": "^5.2.9",
    "concurrently": "^10.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.ibnkamil.antiyoybarracks",
    "productName": "Antiyoy Barracks",
    "copyright": "Copyright © IbnKamil",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-windows.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
